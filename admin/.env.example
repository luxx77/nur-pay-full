# Адрес бэкенда Nur Pay. Без слэша на конце.
VITE_API_BASE_URL=http://localhost:8080

# Значение заголовка admin_api_key — такое же, как ADMIN_API_KEY в
# backend/.env. Все /admin/* запросы уходят с этим заголовком.
VITE_ADMIN_API_KEY=dev-admin-key

# Логин админки. Проверка одноразовая на клиенте, без бэкенда:
# после успешного входа в localStorage пишется admin_logged_in = true.
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=heyThere232
