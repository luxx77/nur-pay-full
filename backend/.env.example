# Подключение к Postgres. Порт совпадает с POSTGRES_PORT ниже.
DATABASE_URL=postgres://nurpay:nurpay@localhost:5433/nurpay?sslmode=disable

# Адрес, на котором слушает API.
HTTP_ADDR=:8080

# Креды Postgres для docker-compose (POSTGRES_USER/PASSWORD/DB).
# Должны совпадать с логином/паролем/базой в DATABASE_URL выше.
POSTGRES_USER=nurpay
POSTGRES_PASSWORD=nurpay
POSTGRES_DB=nurpay

# Порт, на который Postgres выставлен наружу из docker-compose.
# Не 5432: он часто занят локально установленным Postgres.
POSTGRES_PORT=5433

# Комиссии в целых процентах. Комиссию платит получатель,
# формула floor(amount * percent / 100).
ACTIVATION_FEE=1
MERCHANT_PAYMENT_FEE=1

# Ключ для выпуска кодов активации: заголовок admin_api_key.
# Заглушка под админскую авторизацию — на проде так нельзя.
ADMIN_API_KEY=dev-admin-key
