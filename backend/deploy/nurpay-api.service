[Unit]
Description=Nur Pay API
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/nurpay/backend
EnvironmentFile=/opt/nurpay/backend/.env
ExecStart=/opt/nurpay/backend/bin/api
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
