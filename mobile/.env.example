# Адрес бэкенда. Подхватывается через --dart-define-from-file=.env
# (см. lib/core/network/api_client.dart -> ApiClient.defaultBaseUrl).
#
# Если не задано, клиент угадывает сам: 10.0.2.2:8080 для Android-эмулятора,
# localhost:8080 для остальных целей отладки (macOS/web/iOS-симулятор).
# Переопределяй на реальном устройстве — ставь IP компьютера в локальной сети.
NURPAY_API_URL=http://192.168.1.202:8080
